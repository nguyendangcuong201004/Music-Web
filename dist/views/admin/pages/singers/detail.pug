extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main

    h1(class="mb-4") Ca sĩ: #{singer.fullName}

    .card.mb-3
        .card-header Thông tin ca sĩ
        .card-body
            .row
                .col-md-3
                    img(
                        src=singer.avatar
                        alt=singer.fullName
                        class="img-fluid rounded"
                    )
                .col-md-9
                    p
                        b Tên ca sĩ:
                        |  #{singer.fullName}
                    p
                        b Trạng thái:
                        if (singer.status === "active")
                            span(class="badge badge-success ml-1") Hoạt động
                        else
                            span(class="badge badge-danger ml-1") Dừng hoạt động
                    a(
                        href=`/${prefixAdmin}/singers/edit/${singer.id}`
                        class="btn btn-warning btn-sm"
                    ) Chỉnh sửa

    h3 Danh sách bài hát
    .card.mb-3
        .card-header Bài hát của #{singer.fullName}
        .card-body
            if(songs && songs.length > 0)
                table(class="table table-hover table-sm")
                    thead
                        tr
                            th STT
                            th Hình ảnh
                            th Tên bài hát
                            th Lượt nghe
                            th Hành động
                    tbody
                        each item, index in songs
                            tr
                                td #{index+1}
                                td
                                    img(
                                        src=item.avatar
                                        alt=item.title
                                        width="60px"
                                    )
                                td #{item.title}
                                td #{item.listen}
                                td
                                    a(
                                        class="button-action"
                                        href=`/${prefixAdmin}/songs/detail/${item.id}`
                                    ) Chi tiết
            else
                p Ca sĩ này chưa có bài hát nào.
