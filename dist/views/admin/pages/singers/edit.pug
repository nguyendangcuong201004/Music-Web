extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main

    h1(class="mb-4") Chỉnh sửa ca sĩ: #{singer.fullName}

    form(
        action=`/${prefixAdmin}/singers/edit/${singer.id}?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="fullName") Tên ca sĩ
            input(
                type="text"
                class="form-control"
                id="fullName"
                name="fullName"
                value=singer.fullName
                required
            )
        div(
            class="form-group"
            upload-image
        )
            label(for="avatar") Ảnh
            input(
                type="file"
                class="form-control-file"
                id="avatar"
                name="avatar"
                accept="image/*"
                upload-image-input
            )
            img(
                src=singer.avatar
                upload-image-preview
                class="image-preview"
            )

        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked = true ? singer.status=="active" : false
            )
            label(for="statusActive" class="form-check-label") Hoạt động
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusInActive"
                name="status"
                value="inactive"
                checked = true ? singer.status=="inactive" : false
            )
            label(for="statusInActive" class="form-check-label") Dừng Hoạt động
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật
