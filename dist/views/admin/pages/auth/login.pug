extends ../../layouts/auth.pug
include ../../mixins/alert.pug

block main
    +alert-success()
    +alert-error()

    .container.my-5
        .row.justify-content-center
            .col-5
                h1(class="text-center mb-4") Đăng nhập quản trị Spotify
                form(
                    action=`/${prefixAdmin}/auth/login`
                    method="POST"
                )
                    div(class="form-group")
                        label(for="email") Email
                        input(
                            type="email"
                            class="form-control"
                            id="email"
                            name="email"
                            required
                        )
                    div(class="form-group")
                        label(for="password") Mật khẩu
                        input(
                            type="password"
                            class="form-control"
                            id="password"
                            name="password"
                            required
                        )
                    div(class="form-group")
                        button(class="btn btn-primary btn-block" type="submit") Đăng nhập

                p(class="text-center mt-3")
                    | Chưa có tài khoản?
                    a(href=`/${prefixAdmin}/auth/register`)  Đăng ký ngay
