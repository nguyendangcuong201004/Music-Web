extends ../../layouts/default.pug
include ../../mixins/alert.pug

mixin permission-row(name, label)
    tr(data-name=name)
        td #{label}
        each item in records
            td(class="text-center")
                input(
                    type="checkbox"
                    checked = true ? (item.permissions && item.permissions.includes(name)) : false
                )

block main

    h1(class="mb-4") Phân quyền
    +alert-success()

    if(records && records.length > 0)
        div(class="text-right")
            button(
                type="button"
                class="btn btn-primary mb-3"
                button-submit-permissions
            ) Cập nhật
        table(class="table table-hover table-sm" table-permissions)
            thead
                tr
                    th Tính năng
                    each item in records
                        th(class="text-center") #{item.title}
            tbody
                tr(data-name="id" class="d-none")
                    td Id Nhóm quyền
                    each item in records
                        td(class="text-center")
                            input(type="text" value=item.id class="role-id")

                tr(data-name="view")
                    td(colspan=(records.length + 1))
                        b Quyền xem
                +permission-row("topics_view", "Quản lý chủ đề")
                +permission-row("songs_view", "Quản lý bài hát")
                +permission-row("singers_view", "Quản lý ca sĩ")
                +permission-row("roles_view", "Nhóm quyền")
                +permission-row("accounts_view", "Tài khoản admin")
                +permission-row("settings_view", "Cài đặt chung")

                tr(data-name="create")
                    td(colspan=(records.length + 1))
                        b Quyền thêm mới
                +permission-row("topics_create", "Quản lý chủ đề")
                +permission-row("songs_create", "Quản lý bài hát")
                +permission-row("singers_create", "Quản lý ca sĩ")
                +permission-row("roles_create", "Nhóm quyền")
                +permission-row("accounts_create", "Tài khoản admin")

                tr(data-name="edit")
                    td(colspan=(records.length + 1))
                        b Quyền chỉnh sửa
                +permission-row("topics_edit", "Quản lý chủ đề")
                +permission-row("songs_edit", "Quản lý bài hát")
                +permission-row("singers_edit", "Quản lý ca sĩ")
                +permission-row("roles_edit", "Nhóm quyền")
                +permission-row("roles_permissions", "Phân quyền")
                +permission-row("accounts_edit", "Tài khoản admin")
                +permission-row("settings_edit", "Cài đặt chung")

                tr(data-name="delete")
                    td(colspan=(records.length + 1))
                        b Quyền xóa
                +permission-row("topics_delete", "Quản lý chủ đề")
                +permission-row("songs_delete", "Quản lý bài hát")
                +permission-row("singers_delete", "Quản lý ca sĩ")
                +permission-row("roles_delete", "Nhóm quyền")
                +permission-row("accounts_delete", "Tài khoản admin")

        form(
            form-change-permissions
            method="POST"
            action=`/${prefixAdmin}/roles/permissions?_method=PATCH`
        )
            div(class="form-group")
                input(
                    class="form-control d-none"
                    type="text"
                    name="roles"
                )
    else
        p Chưa có nhóm quyền nào.
