extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main

    +alert-success()
    h1(class="mb-4") Nhóm quyền

    .card.mb-3
        .card-header Danh sách
        .card-body
            .row
                .col-8
                .col-4.text-right
                    a(
                        href=`/${prefixAdmin}/roles/create`
                        class="button-add"
                    ) + Thêm mới
            table(
                class="table table-hover table-sm"
            )
                thead
                    tr
                        th STT
                        th Nhóm quyền
                        th Mô tả ngắn
                        th Số tài khoản
                        th Hành động
                tbody
                    if(records && records.length > 0)
                        each item, index in records
                            tr
                                td #{index + 1}
                                td #{item.title}
                                td #{item.description}
                                td #{item.countAccount}
                                td(class="list-button")
                                    a(
                                        class="button-action"
                                        href=`/${prefixAdmin}/roles/permissions`
                                    ) Phân quyền
                                    a(
                                        class="button-action"
                                        href=`/${prefixAdmin}/roles/detail/${item.id}`
                                    ) Chi tiết
                                    a(
                                        class="button-action"
                                        href=`/${prefixAdmin}/roles/edit/${item.id}`
                                    ) Sửa
                                    a(
                                        class="button-action"
                                        button-delete
                                        button-delete-confirm=`Bạn có chắc muốn xóa nhóm quyền "${item.title}"?`
                                        href=`/${prefixAdmin}/roles/delete/${item.id}`
                                    ) Xóa
                    else
                        tr
                            td(colspan="5" class="text-center") Chưa có nhóm quyền nào được tạo.
