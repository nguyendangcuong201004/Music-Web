extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main

    h1(class="mb-4") Chỉnh sửa nhóm quyền: #{record.title}

    form(
        action=`/${prefixAdmin}/roles/edit/${record.id}?_method=PATCH`
        method="POST"
    )
        div(class="form-group")
            label(for="title") Tên nhóm quyền
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
                value=record.title
                required
            )
        div(class="form-group")
            label(for="desc") Mô tả ngắn
            textarea(
                class="form-control"
                id="desc"
                name="description"
                rows="3"
            ) #{record.description}
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật
