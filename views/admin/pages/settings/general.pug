extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main

    +alert-success()
    h1(class="mb-4") Cài đặt chung

    form(
        action=`/${prefixAdmin}/settings/general?_method=PATCH`
        method="POST"
    )
        div(class="form-group")
            label(for="websiteName") Tên website
            input(
                type="text"
                class="form-control"
                id="websiteName"
                name="websiteName"
                value= setting ? setting.websiteName : "Spotify"
                required
            )
        div(class="form-group")
            label(for="phone") Số điện thoại
            input(
                type="text"
                class="form-control"
                id="phone"
                name="phone"
                value= setting ? setting.phone : ""
            )
        div(class="form-group")
            label(for="email") Email
            input(
                type="email"
                class="form-control"
                id="email"
                name="email"
                value= setting ? setting.email : ""
            )
        div(class="form-group")
            label(for="address") Địa chỉ
            input(
                type="text"
                class="form-control"
                id="address"
                name="address"
                value= setting ? setting.address : ""
            )
        div(class="form-group")
            label(for="copyright") Bản quyền (Copyright)
            textarea(
                class="form-control"
                id="copyright"
                name="copyright"
                rows="2"
            ) #{setting ? setting.copyright : ""}
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Lưu cài đặt
