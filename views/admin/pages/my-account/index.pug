extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
    +alert-success()

    .profile-page
        .profile-card
            .profile-banner
            .profile-avatar
                if(user.avatar)
                    img(src=user.avatar alt=user.fullName)
                else
                    img(src="/images/favicon.ico" alt="avatar")
            h3(class="profile-name") #{user.fullName}
            span(class="profile-role")
                i(class="fa-solid fa-shield-halved mr-1")
                | #{role ? role.title : "Chưa có nhóm quyền"}
            if (user.status == "active")
                span(class="badge badge-success profile-status") Hoạt động
            else
                span(class="badge badge-danger profile-status") Dừng hoạt động

            ul(class="profile-info-list")
                li
                    i(class="fa-solid fa-envelope")
                    .profile-info-item
                        small Email
                        span #{user.email}
                li
                    i(class="fa-solid fa-phone")
                    .profile-info-item
                        small Số điện thoại
                        span #{user.phone ? user.phone : "Chưa cập nhật"}

            a(
                href=`/${prefixAdmin}/my-account/edit`
                class="btn btn-profile"
            )
                i(class="fa-solid fa-pen mr-1")
                |  Chỉnh sửa thông tin
