extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main

    h1(class="mb-4") Chỉnh sửa tài khoản user: #{user.fullName}

    form(
        action=`/${prefixAdmin}/users/edit/${user.id}?_method=PATCH`
        method="POST"
    )
        div(class="form-group")
            label(for="fullName") Họ tên
            input(
                type="text"
                class="form-control"
                id="fullName"
                name="fullName"
                value=user.fullName
                required
            )
        div(class="form-group")
            label(for="email") Email
            input(
                type="email"
                class="form-control"
                id="email"
                name="email"
                value=user.email
                required
            )
        div(class="form-group")
            label(for="password") Mật khẩu (bỏ trống nếu không đổi)
            input(
                type="password"
                class="form-control"
                id="password"
                name="password"
                minlength="6"
            )
        div(class="form-group")
            label(for="phone") Số điện thoại
            input(
                type="text"
                class="form-control"
                id="phone"
                name="phone"
                value=user.phone
            )

        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked = true ? user.status=="active" : false
            )
            label(for="statusActive" class="form-check-label") Hoạt động
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusInActive"
                name="status"
                value="inactive"
                checked = true ? user.status=="inactive" : false
            )
            label(for="statusInActive" class="form-check-label") Dừng Hoạt động
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật
